<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12: the espresso ground, so a dark app never
     flashes white. Android 12+ draws its own splash with the launcher icon on
     windowSplashScreenBackground (values/styles.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ground" />
</layer-list>
